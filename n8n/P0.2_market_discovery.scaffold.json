    {
      "id": "parse-markets--bands",
      "name": "Parse markets + bands",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Normalise the Polymarket response into `markets` + `bands` rows.\n//\n// GROUNDED: the target columns are exactly what sql/ad4_00_preflight.sql\n// guarantees - markets(market_id, city_key, resolution_date, unit, closed,\n// event_slug, condition_id) and bands(band_id, market_id, band_lo, band_hi,\n// open_low, open_high, band_label, token_yes, token_no).\n//\n// NOT GROUNDED: the shape of the upstream payload. Adjust the field reads\n// below to match whatever your real P0.2 receives - the output shape is the\n// part that must not change.\nconst cities = $('Load cities').all().map(i => i.json);\nconst raw = $('Fetch markets').all().map(i => i.json).flat();\n\nconst markets = [], bands = [];\nfor (const m of raw) {\n  const slug = m.slug || m.event_slug || '';\n  const city = cities.find(c => slug.includes(c.city_key)) || null;\n  if (!city) continue;                       // not one of our 54 cities\n\n  const marketId = m.market_id || m.id;      // must be stable across runs\n  markets.push({\n    market_id: marketId,\n    city_key: city.city_key,\n    resolution_date: (m.resolution_date || m.endDate || '').slice(0, 10),\n    unit: city.unit || 'C',\n    closed: Boolean(m.closed),\n    event_slug: slug,\n    condition_id: m.conditionId || m.condition_id || null,\n  });\n\n  // One band per outcome. band_lo/band_hi are the numeric bounds;\n  // open_low/open_high mark the unbounded tails (\"27 or below\", \"31+\").\n  for (const o of (m.outcomes || m.bands || [])) {\n    bands.push({\n      band_id: o.band_id || o.id,\n      market_id: marketId,\n      band_lo: o.band_lo ?? o.lo ?? null,\n      band_hi: o.band_hi ?? o.hi ?? null,\n      open_low: Boolean(o.open_low),\n      open_high: Boolean(o.open_high),\n      band_label: o.label || o.band_label || null,\n      token_yes: o.token_yes || (o.tokens || [])[0] || null,\n      token_no:  o.token_no  || (o.tokens || [])[1] || null,\n    });\n  }\n}\nreturn [{ json: { markets, bands, n_markets: markets.length, n_bands: bands.length } }];"
      }
    },
