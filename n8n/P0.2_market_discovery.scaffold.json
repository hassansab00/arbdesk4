    {
      "id": "summary",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "const p = $('Parse markets + bands').first().json;\nconst rows = (p.n_markets || 0) + (p.n_bands || 0);\nconst summary = `AD4 P0.2: ${p.n_markets} markets, ${p.n_bands} bands upserted.`;\nreturn [{ json: {\n  summary,\n  status: rows > 0 ? 'ok' : 'attention',\n  rows,\n  log: {\n    p_job: 'P0.2_market_discovery',\n    p_status: rows > 0 ? 'ok' : 'attention',\n    p_rows: rows,\n    p_detail: {\n      summary,\n      n_markets: p.n_markets ?? null,\n      n_bands: p.n_bands ?? null,\n      trigger: $execution.mode,\n      execution_id: $execution.id,\n    },\n  },\n} }];"
      }
