    {
      "id": "render-html",
      "name": "Render HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        160
      ],
      "parameters": {
        "jsCode": "const kind = $('Config').first().json.digest_kind;\nconst payload = $input.first().json;\nconst money = (v) => v == null ? '-' : (Math.abs(v) >= 1000 ? '$' + (v/1000).toFixed(1) + 'k' : '$' + Number(v).toFixed(0));\nlet subject, html;\nif (kind === 'morning') {\n  const opps = (payload.top_opportunities || []).slice(0, 15);\n  // Volume sits beside price and edge, not buried: an edge on a band that\n  // has not traded in 24h is a different proposition from the same edge on\n  // a busy one, and the brief has to say which it is.\n  const rows = opps.map(o => {\n    const thin = o.thin_market ? ' style=\"background:#fff4e0\"' : '';\n    return `<tr${thin}><td>${o.display_name || o.city_key}</td><td>${o.band_label || ''}</td><td>${o.side}</td>` +\n      `<td>${(o.market_price*100).toFixed(0)}c</td><td>${(o.model_prob*100).toFixed(0)}%</td>` +\n      `<td>${(o.edge_net_pp*100).toFixed(1)}pp</td><td>${money(o.fillable_usd_5c)}</td>` +\n      `<td>${money(o.volume_usd)}${o.thin_market ? ' &#9888;' : ''}</td><td>${o.n_trades ?? 0}</td><td>${o.regime_label}</td></tr>`;\n  }).join('');\n  const thinCount = opps.filter(o => o.thin_market).length;\n  const totalVol = opps.reduce((s, o) => s + (o.volume_usd || 0), 0);\n  subject = 'AD4 Morning Brief';\n  html = `<h2>AD4 Morning Brief</h2><p>Generated ${payload.generated_at}</p>` +\n    `<p>${opps.length} ranked opportunities &middot; ${money(totalVol)} traded across them in the last 24h` +\n    (thinCount ? ` &middot; <b>${thinCount} on thin-volume bands (shaded)</b>` : '') + `</p>` +\n    `<table border=1 cellpadding=4 style=\"border-collapse:collapse;font-family:system-ui;font-size:13px\">` +\n    `<tr><th>City</th><th>Band</th><th>Side</th><th>Price</th><th>Model P</th><th>Net edge</th>` +\n    `<th>Depth 5c</th><th>Vol 24h</th><th>Trades</th><th>Regime</th></tr>${rows}</table>` +\n    `<p style=\"font-size:12px;color:#666\">Depth is what the current quote can absorb inside 5c of slippage. ` +\n    `Vol 24h is what actually traded. A shaded row is quoted but barely traded - the ladder overstates how much of it you can take.</p>`;\n} else {\n  const trades = payload.settled_today || [];\n  const rows = trades.map(t => `<tr><td>${t.strategy_id}</td><td>${t.band_id}</td><td>${t.side}</td><td>${t.shares}</td><td>${t.net_pnl?.toFixed(2)}</td></tr>`).join('');\n  const byStrategy = payload.net_pnl_by_strategy || {};\n  const stratRows = Object.entries(byStrategy).map(([k,v]) => `<tr><td>${k}</td><td>${Number(v).toFixed(2)}</td></tr>`).join('');\n  subject = 'AD4 End of Day Report';\n  html = `<h2>AD4 End of Day</h2><p>Generated ${payload.generated_at}</p><h3>Net P&L by strategy</h3><table border=1 cellpadding=4>${stratRows}</table><h3>Settled today</h3><table border=1 cellpadding=4><tr><th>Strategy</th><th>Band</th><th>Side</th><th>Shares</th><th>Net P&L</th></tr>${rows}</table><p style=\"font-size:12px;color:#666\">All figures are net. Gross is never shown outside the cost-analysis view.</p>`;\n}\nreturn [{ json: { subject, html } }];"
      }
    },
