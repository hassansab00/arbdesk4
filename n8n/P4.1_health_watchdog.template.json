              "field": "cronExpression",
              "expression": "0 */6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        80
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "supabase_url",
              "type": "string",
              "value": ""
            },
            {
              "id": "2",
              "name": "service_key",
              "type": "string",
              "value": ""
            },
            {
              "id": "3",
              "name": "alert_email",
              "type": "string",
              "value": ""
            }
          ]
        }
      }
