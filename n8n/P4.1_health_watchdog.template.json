    {
      "id": "evaluate",
      "name": "Evaluate Thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        80
      ],
      "notes": "Checks run sequentially (Config -> book -> forecast -> ingest -> anomalies -> here) rather than in parallel through a Merge node, specifically so this node can reliably read all four via $('NodeName').first().json without depending on a Merge node's exact combine semantics for this n8n version.",
      "parameters": {
        "jsCode": "// n8n turns a JSON array response into ONE ITEM PER ROW. So the rows of a\n// PostgREST query are $('Node').all().map(i => i.json) - NOT\n// $('Node').first().json, which returns only the first row's object.\n//\n// The previous version used .first().json everywhere and then indexed or\n// .reduce()'d it as if it were an array. The effect: \"stale_book\" and\n// \"stale_forecast\" fired on EVERY run regardless of freshness, failed ingest\n// jobs and anomalies were never reported at all, and the volume check threw\n// and reported itself as a failure. A watchdog that always cries wolf and\n// never sees the wolf is worse than no watchdog.\n//\n// alwaysOutputData means a query with no rows still yields one item with an\n// empty object, so empties are filtered out rather than counted as rows.\nconst rowsOf = (name) => $(name).all()\n  .map(i => i.json)\n  .filter(r => r && typeof r === 'object' && Object.keys(r).length > 0);\n\nconst now = Date.now();\nconst failures = [];\nconst context_notes = [];\nconst checks = {};\n\n// --- book freshness ---------------------------------------------------\nconst bookRows = rowsOf('Check: latest book_snapshot');\nconst bookRow = bookRows[0];\nif (bookRow?.observed_at) {\n  const ageMin = (now - new Date(bookRow.observed_at).getTime()) / 60000;\n  checks.book_age_min = Number(ageMin.toFixed(0));\n  if (ageMin > 60) failures.push(`stale_book: ${ageMin.toFixed(0)}min old`);\n} else {\n  failures.push('stale_book: book_snapshots returned no rows at all');\n}\n\n// --- forecast freshness -----------------------------------------------\nconst fcRows = rowsOf('Check: latest forecast run');\nconst fcRow = fcRows[0];\nif (fcRow?.run_at) {\n  const ageH = (now - new Date(fcRow.run_at).getTime()) / 3600000;\n  checks.forecast_age_h = Number(ageH.toFixed(1));\n  if (ageH > 12) failures.push(`stale_forecast: ${ageH.toFixed(1)}h old`);\n} else {\n  failures.push('stale_forecast: weather_forecasts returned no rows at all');\n}\n\n// --- failed ingest jobs in the last 24h -------------------------------\nconst errRows = rowsOf('Check: failed ingest jobs (24h)')\n  .filter(r => r.logged_at && (now - new Date(r.logged_at).getTime()) < 24 * 3600000);\nchecks.failed_jobs_24h = errRows.length;\nif (errRows.length) {\n  const jobs = [...new Set(errRows.map(r => r.job).filter(Boolean))];\n  failures.push(`${errRows.length} failed ingest job(s) in 24h: ${jobs.join(', ')}`);\n}\n\n// --- anomalies in the last 24h ----------------------------------------\nconst anomRows = rowsOf('Check: anomalies (24h)')\n  .filter(r => r.detected_at && (now - new Date(r.detected_at).getTime()) < 24 * 3600000);\nchecks.anomalies_24h = anomRows.length;\nif (anomRows.length) failures.push(`${anomRows.length} anomaly row(s) in 24h`);\n\n// n8n's own execution count cannot be read via Supabase - check it against\n// n8n's Insights page; not automated here (docs/n8n_workflows.md).\n\n// --- market volume ----------------------------------------------------\n// A desk with live books and zero traded volume is not a working desk:\n// either the trade ingest has stopped, or every market really has gone\n// quiet. Both need telling, and neither shows up above - book_snapshots\n// keeps updating either way.\nconst volRows = rowsOf('Check: traded volume (24h)');\nconst totalVol = volRows.reduce((s, r) => s + Number(r.volume_usd || 0), 0);\nconst totalTrades = volRows.reduce((s, r) => s + Number(r.n_trades || 0), 0);\nchecks.volume_usd_24h = Number(totalVol.toFixed(0));\nchecks.trades_24h = totalTrades;\nchecks.cities_with_volume = volRows.length;\n\nif (volRows.length === 0) {\n  failures.push('no_market_volume: v_city_volume returned no rows - trades_observed is empty or the trade ingest has stopped');\n} else if (totalVol === 0) {\n  failures.push('no_market_volume: $0 traded across all cities in the last 24h');\n}\n// Reported either way, so a clean run still tells you the size of the\n// market you are trading into.\ncontext_notes.push(\n  `market volume 24h: $${totalVol.toFixed(0)} across ${volRows.length} cities, ${totalTrades} trades`);\n\nreturn [{ json: {\n  has_failures: failures.length > 0,\n  failures, context_notes, checks,\n  checked_at: new Date().toISOString(),\n} }];"
      }
    },
    {
      "id": "if-failures",
      "name": "Any failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1820,
        80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.has_failures }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2080,
        0
      ],
      "parameters": {
        "fromEmail": "ad4-watchdog@example.com",
        "toEmail": "={{ $('Config').first().json.alert_email }}",
        "subject": "=AD4 Health Watchdog: {{ $json.failures.length }} check(s) failing",
        "emailFormat": "text",
        "text": "={{ $json.failures.join('\\n') }}\n\n---\n{{ ($json.context_notes || []).join('\\n') }}"
      }
    },
    {
      "id": "summary",
      "name": "Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        200
      ],
      "parameters": {
        "jsCode": "const r = $('Evaluate Thresholds').first().json;\nconst failures = r.failures || [];\nconst summary = r.has_failures\n  ? `AD4 P4.1: ${failures.length} check(s) FAILED - email sent.`\n  : 'AD4 P4.1: all clear.';\nreturn [{ json: {\n  summary,\n  status: r.has_failures ? 'error' : 'ok',\n  rows: failures.length,\n  log: {\n    p_job: 'P4.1_health_watchdog',\n    p_status: r.has_failures ? 'error' : 'ok',\n    p_rows: failures.length,\n    p_detail: {\n      summary,\n      failures,\n      checks: r.checks ?? null,\n      trigger: $execution.mode,\n      execution_id: $execution.id,\n    },\n  },\n} }];"
      }
    },
